<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Required for AmbientLifecycleObserver to arm ambient mode (redesign §1.4):
         without it, onEnterAmbient never fires and the system just backgrounds the
         app to the watch face on dim/wrist-down instead of keeping it visible.
         The library holds the lock, not us — app code acquiring a wake lock is
         forbidden by WearAppPowerPolicyTest (#164 replaced ours with an alarm). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The OngoingActivity re-entry chip is a posted notification (redesign §1.4
         / R6). Runtime-requested on API 33+ the moment a workout is underway;
         denial simply hides the chip and never blocks logging. Local, on-device
         only — no INTERNET implication. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The rest timer's single buzz at zero (redesign §2.3 / R5). Normal,
         install-time, on-device — no INTERNET implication. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:name=".StrengthLogWearApp"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The day on the watch face (glance-surfaces brief §2). Exported because the
          watch-face process binds it; locked to BIND_COMPLICATION_PROVIDER, which
          only the system holds, so nothing else can call in. Data Layer pushes,
          activation, and civil-day/timezone broadcasts request fresh renders.
        -->
        <service
            android:name=".glance.DayComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_day_complication"
            android:label="@string/glance_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- TIMEZONE_CHANGED is on the implicit-broadcast exception list; the
             midnight rollover arrives as an explicit alarm broadcast scheduled at
             each glance render, because DATE_CHANGED never reaches manifest
             receivers on API 26+. -->
        <receiver
            android:name=".glance.CivilDayChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          The day in the tile carousel (glance-surfaces brief §3). Same posture: the
          system binds it, BIND_TILE_PROVIDER keeps everyone else out.
        -->
        <service
            android:name=".glance.DayTileService"
            android:exported="true"
            android:label="@string/glance_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview_day" />
        </service>

        <!--
          Data Layer listener that pokes the two surfaces when a new snapshot lands.
          exported="true" with no permission is the required posture for a
          WearableListenerService — Play Services is the caller and it binds by
          intent filter (same declaration as the phone's
          StrengthLogWearListenerService). The filter is scoped to /strengthlog, so
          only our own paths can start it, and onDataChanged reads bytes it treats
          as untrusted.
        -->
        <service
            android:name=".glance.GlanceUpdateService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/strengthlog"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:host="*"
                    android:path="/strengthlog_phone"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>

</manifest>
