<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Health Connect permissions (PLAN.md A3). These are on-device IPC
      permissions granted through the Health Connect provider — NOT INTERNET
      (the app still declares no android.permission.INTERNET, so the local-first
      promise holds). All four are requested together, from the Log screen's
      Connect card; the user can allow or deny each one, and the app is fully
      functional with any or none of them granted.
    -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Cardio step boundaries buzz (C1b); install-time, not runtime. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Lets HealthConnectClient.getSdkStatus see the Health Connect provider on
      API 30+ package-visibility. No launch, no data — just availability.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!--
      Auto Backup (allowBackup): opts into Google One cloud backup and
      device-to-device transfer for the Room DB + DataStore prefs, at no
      engineering cost. It's a free ride on top of, not a replacement for,
      the versioned JSON full backup (PLAN.md A2) — that JSON export is
      the user-visible, guaranteed way to move data on purpose; Auto
      Backup is opaque, best-effort, and skipped if the OEM transfer tool
      doesn't invoke it. dataExtractionRules covers API 31+; the identical
      fullBackupContent rules back-fill the API 26-30 floor.

      Predictive back opts every BackHandler and PredictiveBackHandler into the
      platform back-invoked API. The system can preview back to home, and app
      handlers receive gesture progress instead of one terminal event.
    -->
    <application
        android:name=".StrengthLogApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.StrengthLog.Starting"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <receiver android:name=".rest.RestAlarmReceiver" android:exported="false" />
        <receiver android:name=".rest.RestActionReceiver" android:exported="false" />

        <!--
          MainActivity is never launched directly — only through one of the
          Launcher_Day* aliases below, which is what carries the LAUNCHER
          intent-filter and the stable barbell icon. Unexported so there's no
          second, iconless path into the app.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!--
          Health Connect's mandatory permissions-rationale target. The provider
          launches this to explain why the app requests health permissions.
          Exported (it has to be launchable by the Health Connect provider) but
          inert: it shows a static, on-device rationale screen and reads no
          data. Two filters cover both eras — the pre-14 provider APK fires
          SHOW_PERMISSIONS_RATIONALE; platform Health Connect (API 34+) fires
          VIEW_PERMISSION_USAGE with the HEALTH_PERMISSIONS category.
        -->
        <activity
            android:name=".health.HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".health.ViewPermissionUsageActivity"
            android:targetActivity=".health.HealthRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Session share card provider (docs/briefs/session-share.md §3).
          Unexported and grants read access only to the render it just wrote —
          @xml/file_paths scopes the exposed tree to cache/shares/ alone, so
          this can never serve any other file in the app's cache or storage.
          No new permission: the share sheet itself is the boundary, and
          ACTION_SEND is how every other app already receives shared content.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Wear Data Layer receiver. Google Play Services binds this service to
          deliver watch->phone set-edit messages, waking the app process if it was
          dead so an edit made while the phone app wasn't running still lands.

          exported="true" is required and safe: only Google Play Services binds a
          WearableListenerService (the bind is gated by that trusted process), and
          the filter is path-scoped to /strengthlog so nothing but our own
          set-edit messages can reach it. The service validates and dedupes every
          payload before touching data (SetEditApplier), and no INTERNET permission
          is added — the Data Layer is on-device Play-services IPC.
        -->
        <service
            android:name=".sync.StrengthLogWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/strengthlog" />
            </intent-filter>
        </service>

        <!--
          Home-screen widget (glance-surfaces.md §1). exported="true" is what the
          AppWidget contract requires — the system's AppWidgetService is what
          broadcasts APPWIDGET_UPDATE, and it can only reach an exported receiver.
          That is also the only filter declared: no custom action any other app
          could fire, and the receiver reads state without accepting a single
          value from the intent, so the widest possible caller can do no more
          than ask us to repaint what the app already shows.
        -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:label="@string/widget_today_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!--
          Legacy launcher aliases remain so pinned home-screen icons survive
          upgrades. Every alias uses the same barbell. Day A ships enabled;
          LauncherAliasMigration repairs interrupted historical switches once.
        -->
        <activity-alias
            android:name=".Launcher_DayA"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Launcher_DayB"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Launcher_DayC"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Launcher_DayD"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Launcher_DayE"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Launcher_DayF"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Launcher_DayG"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
