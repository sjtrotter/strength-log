<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background (spec §8.5 near-black) — matches the Compose Background
         token so the launch window and any pre-Compose frame never flash light. -->
    <color name="window_background">#0D0D0F</color>
    <color name="splash_background">#F1EFEA</color>

    <!-- Widget roles mirror the phone's light palette; night overrides live in values-night. -->
    <color name="widget_background">#F1EFEA</color>
    <color name="widget_border">#D8D4CC</color>
    <color name="widget_text_primary">#1B1B1E</color>
    <color name="widget_text_secondary">#5C5C64</color>
    <color name="widget_done">#37774E</color>
    <color name="widget_preview_block">#C1440E</color>
    <color name="widget_preview_on_block">#F2F2F0</color>
    <color name="widget_preview_accent">#8F3813</color>
</resources>
