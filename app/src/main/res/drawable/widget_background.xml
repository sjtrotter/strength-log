<?xml version="1.0" encoding="utf-8"?>
<!-- Near-black fill with a hairline border (spec §8.5), rounded to the host's
     own widget radius so the card sits flush in the launcher's masking. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
