<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/widget_day_letter"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:fontFamily="@font/barlow_condensed_bold"
        android:textSize="32sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_day_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:fontFamily="@font/barlow_condensed_semibold"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_stat_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/barlow_condensed_bold"
            android:textSize="24sp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_secondary"
            android:text="@string/widget_no_program" />

        <FrameLayout
            android:id="@+id/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/widget_progress_track"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_progress_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_progress_fill"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
